                  </Label>
                  <Label alignment="CENTER" prefHeight="10.0" prefWidth="694.0" text="Strawberries have a higher concentration of vitamin C compared to oranges!" textAlignment="CENTER">
                     <font>
                        <Font name="Comic Sans MS" size="14.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
